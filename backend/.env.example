# TMDB API anahtarınızı https://www.themoviedb.org/settings/api adresinden ücretsiz alabilirsiniz
TMDB_API_KEY=buraya_tmdb_api_anahtariniz

# Groq API (AI Asistan için) - https://console.groq.com/ adresinden ücretsiz alabilirsiniz
GROQ_API_KEY=buraya_groq_api_anahtariniz

# JWT için rastgele, uzun bir gizli anahtar yazın
JWT_SECRET=cok-gizli-bir-anahtar-buraya-yazin-degistirin

# Sunucu portu
PORT=5000

# İlk yönetici hesabı otomatik oluşturulsun mu? (ilk açılışta bir kez)
ADMIN_EMAIL=admin@cinemaai.local
ADMIN_PASSWORD=Admin123!
ADMIN_USERNAME=admin
